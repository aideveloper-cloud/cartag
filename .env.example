# สำหรับพัฒนาในเครื่อง — Postgres จาก: docker run -d --name cartag-db -p 5433:5432 -e POSTGRES_PASSWORD=dev postgres:16
DATABASE_URL="postgresql://postgres:dev@localhost:5433/cartag"
BASE_URL="http://localhost:3000"
ADMIN_PASSWORD="admin1234"
# รหัสผู้ดูอย่างเดียว (viewer) — ดูข้อมูล/ดาวน์โหลดรายงานได้ แต่เพิ่ม/แก้/ลบไม่ได้; ไม่ตั้ง = ไม่มี viewer
# VIEWER_PASSWORD="viewer1234"
