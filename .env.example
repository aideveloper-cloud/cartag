DATABASE_URL="file:./dev.db"

# URL ที่ฝังใน QR — ต้องเป็นที่อยู่ที่มือถือเข้าถึงได้ทั้งจาก Wi-Fi และเน็ตมือถือ
# แนะนำโดเมนจริงแบบ https เช่น https://car.example.co.th  (ตั้งให้ถูกก่อนพิมพ์ QR)
BASE_URL="http://localhost:3000"
# โดเมนสำหรับ HTTPS อัตโนมัติใน docker-compose (ไม่มี https://)
DOMAIN="car.example.co.th"

# รหัสผ่านหน้าแอดมิน — ใช้รหัสที่เดายาก
ADMIN_PASSWORD="change-me"

# ระยะทางต่อทริปที่เกินนี้ต้องกดยืนยัน (กม.)
MAX_TRIP_KM=1000
# เก็บรูปหน้าผู้ยืมกี่วันก่อนลบอัตโนมัติ
SELFIE_RETENTION_DAYS=180
