# คัดลอกเป็น .env.server (ห้าม commit) — kgf-deploy.sh จะส่งขึ้น server เป็น .env ของ container

# Postgres กลางบน ServerKG (สร้าง user/DB ตาม README หัวข้อ Deploy)
DATABASE_URL=postgresql://cartag:<รหัสผ่าน DB>@kgf-postgres:5432/cartag

# URL ที่ฝังใน QR
BASE_URL=https://cartag.kgarden.co.th

# รหัสผ่านหน้าแอดมิน — ใช้รหัสที่เดายาก
ADMIN_PASSWORD=<รหัสผ่านแอดมิน>

MAX_TRIP_KM=1000
SELFIE_RETENTION_DAYS=180
