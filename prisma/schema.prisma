generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vehicle {
  id        String   @id @default(cuid())
  plate     String   @unique // ทะเบียนรถ เช่น "2 ฒพ 2523"
  code      String   @unique // รหัสสั้นที่ฝังใน QR เช่น "v1"
  createdAt DateTime @default(now())
  trips     Trip[]
}

model Employee {
  id         String   @id @default(cuid())
  code       String   @unique // รหัสพนักงาน
  name       String
  department String
  active     Boolean  @default(true) // ปิดแทนการลบ เพื่อให้ประวัติเดิมยังอ้างอิงได้
  createdAt  DateTime @default(now())
  trips      Trip[]
}

model Trip {
  id            String    @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id])
  departedAt    DateTime  @default(now()) // วันที่ + เวลาออกเดินทาง
  origin        String    // ออกเดินทางจาก
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id])
  driver        String    // ผู้ใช้รถ (เก็บชื่อ ณ ตอนยืม เผื่อพนักงานเปลี่ยนชื่อ/แผนกภายหลัง)
  department    String    @default("") // แผนก
  destination   String    // สถานที่ไป
  mileageStart  Int       // เลขไมล์ก่อนเดินทาง
  mileageEnd    Int?      // เลขไมล์หลังเดินทาง (null = ยังไม่คืนรถ)
  returnedAt    DateTime? // วันที่ + เวลาคืนรถ
  photoStart    String?   // id ของ Photo: รูปเลขไมล์ตอนออก
  photoEnd      String?   // id ของ Photo: รูปเลขไมล์ตอนคืน
  warnings      String?   // คำเตือนเลขไมล์ที่ผู้ใช้กดยืนยันผ่าน ให้แอดมินตรวจ
  selfie        String?   // id ของ Photo: รูปหน้าผู้ยืม (ลบอัตโนมัติเมื่อครบ SELFIE_RETENTION_DAYS)
  createdAt     DateTime  @default(now())

  @@index([vehicleId, departedAt])
}

// เก็บรูปในฐานข้อมูล (ย่อจากมือถือแล้ว ~30–150KB/รูป) เพื่อให้ backup ของ Postgres ครอบคลุมรูปด้วย
// และ container ไม่ต้องมี volume
model Photo {
  id        String   @id @default(uuid())
  data      Bytes
  createdAt DateTime @default(now())
}
